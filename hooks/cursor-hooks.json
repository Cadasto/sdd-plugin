{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash hooks/session-start.sh",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash hooks/spec-edit-reminder.sh",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "bash hooks/session-stop.sh",
        "timeout": 10
      }
    ]
  }
}
